# Copy to .env and fill in.

# ── LLM ───────────────────────────────────────────────────────────────
# Hugging Face token — required if the model is gated.
HF_TOKEN=hf_...

# Model name (Hugging Face repo) and the served-model-name used by HA.
VLLM_MODEL=Qwen/Qwen3-32B-Instruct-FP8
VLLM_SERVED_NAME=qwen3-32b

# Sizing — adjust if your GPU has less VRAM than mine.
VLLM_MAX_LEN=16384
VLLM_GPU_UTIL=0.70
VLLM_MAX_SEQS=4

# ── Home Assistant ────────────────────────────────────────────────────
# URL of your HA instance (LAN or Tailscale). Used by the vision
# sidecar for camera snapshots.
HA_URL=http://192.168.0.125:8123

# Long-Lived Access Token. Generate one at:
#   Profile → Security → Long-Lived Access Tokens
HA_TOKEN=eyJ...

# ── Optional service overrides ────────────────────────────────────────
# Leave defaults unless you need to remap ports.
# VLLM_PORT=8000
# PARAKEET_PORT=10300
# KOKORO_PORT=8880
# WYOMING_KOKORO_PORT=10301
# VISION_SIDECAR_PORT=8091
# METRICS_SIDECAR_PORT=8092
# SCRAPE_INTERVAL_S=2.0
