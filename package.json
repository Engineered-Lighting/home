{
  "name": "home",
  "version": "0.1.1",
  "description": "Local AI home coordinator. The existing Home desktop app lives in app/; experimental sibling apps live under apps/.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "serve app/src -p 5180 --no-clipboard --no-port-switching",
    "dev:assets": "node tools/serve-apartment-assets.mjs",
    "dev:simulation": "serve app/src -p 5180 --no-clipboard --no-port-switching",
    "web:dev": "node web-gateway/server.mjs",
    "web:start": "node web-gateway/server.mjs",
    "build:home-agent-panel": "node tools/build-home-agent-panel.js",
    "web:check": "node web-gateway/server.mjs --check",
    "web:mobile-audit": "node tools/mobile-web-screenshot-audit.mjs",
    "web:apartment-live-camera-audit": "node tools/audit-apartment-live-camera.mjs",
    "web:mobile-audit:deep": "node tools/mobile-web-screenshot-audit.mjs --profile mobile-deep",
    "web:desktop-audit": "node tools/mobile-web-screenshot-audit.mjs --profile desktop",
    "web:mobile-audit:matrix": "node tools/mobile-web-screenshot-audit.mjs --matrix-only",
    "test:services": "node tools/run-home-services-tests.js",
    "test:security": "node tools/run-home-security-tests.js",
    "test:native-agent-security": "node tools/build-home-agent-panel.js && node tools/run-native-agent-security-tests.js && node tools/run-agent-origin-boundary-tests.mjs && node tools/run-native-agent-gateway-tests.js && node tools/run-web-gateway-path-security-tests.mjs",
    "test:resilience": "node tools/run-resilience-tests.js",
    "test:apartment3d": "node tools/run-apartment-3d-contract-tests.js",
    "test:apartment-aiming": "node tools/run-apartment-aiming-tests.js",
    "test:chat-dedupe": "node tools/run-chat-dedupe-tests.js",
    "test:natural-look": "node tools/run-natural-look-routing-tests.js",
    "test:frigate-perception": "node tools/run-frigate-perception-tests.js",
    "frigate:perception:capture": "node tools/capture-frigate-perception-fixtures.mjs",
    "stack:inventory": "node tools/stack-upgrade-inventory.mjs",
    "stack:inventory:json": "node tools/stack-upgrade-inventory.mjs --json",
    "stack:inventory:outdated": "node tools/stack-upgrade-inventory.mjs --npm-outdated",
    "stack:upgrade:test": "node tools/run-stack-upgrade-plan-tests.js",
    "llm:test:deterministic": "node tools/run-chat-dedupe-tests.js && py -3 tools/test-workflow-scenarios.py",
    "llm:test:quick": "py -3 tools/diagnose-identity.py --workflow --quick --phase1-only",
    "llm:test:read-only": "py -3 tools/diagnose-identity.py --workflow --quick",
    "llm:test:write-gated": "py -3 tools/diagnose-identity.py --workflow --quick --include-write-gated",
    "llm:test:travel-mode": "py -3 tools/diagnose-identity.py --workflow --quick --only travel_mode_blocks_light_on --include-write-gated",
    "llm:test:ui": "node tools/run-chat-ui-regression.js",
    "dev:home2": "npm --workspace apps/home-2 run dev",
    "build:home2": "npm --workspace apps/home-2 run build",
    "test:home2": "npm --workspace apps/home-2 run test"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
