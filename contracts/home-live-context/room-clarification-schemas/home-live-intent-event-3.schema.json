{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "home-live-intent-event-3"
    },
    "version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "room_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "domain_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "manifest_ref": {
      "$ref": "#/$defs/pin"
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "origin": {
      "const": "human_declaration"
    },
    "truth_role": {
      "const": "runtime_intent"
    },
    "kind": {
      "const": "activity_reply"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person_ref": {
          "$ref": "#/$defs/person"
        },
        "subject_ref": {
          "$ref": "#/$defs/subject"
        },
        "episode_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "person_ref",
        "subject_ref",
        "episode_id",
        "scene_id",
        "pending_ref"
      ]
    },
    "set_at": {
      "type": "number",
      "minimum": 0
    },
    "available_at": {
      "type": "number",
      "minimum": 0
    },
    "valid_until": {
      "type": "number",
      "minimum": 0
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "enum": [
            "using_material",
            "not_using_material",
            "unsure"
          ]
        }
      },
      "required": [
        "answer"
      ]
    },
    "reply_to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "manifest_ref",
    "actor_ref",
    "origin",
    "truth_role",
    "kind",
    "target",
    "set_at",
    "available_at",
    "valid_until",
    "value",
    "reply_to"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-live-intent-event-3.schema.json",
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "domain_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "track_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          ]
        }
      },
      "required": [
        "site_id",
        "room_id",
        "session_id",
        "domain_epoch",
        "track_epoch",
        "pid"
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "subject_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "subject_id",
        "subject_epoch"
      ]
    }
  }
}
