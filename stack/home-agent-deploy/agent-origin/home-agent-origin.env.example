# This must be an exact HTTPS origin. The production canary uses a dedicated
# port-origin on the tailnet DNS name; it is not the legacy port-443 origin.
HOME_AGENT_WEB_PUBLIC_ORIGIN=https://home-app.example.ts.net:8443

# Never change this to a LAN or wildcard address. Tailscale Serve is the only
# intended ingress and terminates TLS before this loopback listener.
HOME_AGENT_WEB_BIND_ADDR=127.0.0.1
HOME_AGENT_WEB_PUBLISHED_PORT=8096

# Existing internal Docker network created by stack/home-agent-compose.yml.
HOME_AGENT_API_NETWORK=home-agent_api-net
