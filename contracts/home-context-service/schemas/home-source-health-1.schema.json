{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-source-health-1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "home-source-health-1"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "domain_epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "status": {
      "enum": [
        "functional",
        "unavailable",
        "failed",
        "revoked"
      ]
    },
    "observed_at": {
      "type": "number",
      "minimum": 0
    },
    "available_at": {
      "type": "number",
      "minimum": 0
    },
    "valid_until": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "source_id",
    "status",
    "observed_at",
    "available_at",
    "valid_until",
    "reason"
  ]
}
