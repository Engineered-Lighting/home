# Compatibility template for an existing repo1-SFTP deployment. New
# standalone Ubuntu installations use pgbackrest.conf.example instead.
[global]
repo1-type=sftp
repo1-path=/repo/home-agent
repo1-sftp-host=REPLACE_WITH_SEPARATE_BACKUP_HOST
repo1-sftp-host-port=22
repo1-sftp-host-user=homeagent_backup
repo1-sftp-private-key-file=/run/pgbackrest-sftp/id_ed25519
repo1-sftp-public-key-file=/run/pgbackrest-sftp/id_ed25519.pub
repo1-sftp-host-key-check-type=fingerprint
repo1-sftp-host-key-hash-type=sha256
repo1-sftp-host-fingerprint=REPLACE_WITH_VERIFIED_SHA256_HEX_FINGERPRINT
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATE_BACKUP_SECRET
repo1-bundle=y
repo1-retention-full=4
repo1-retention-diff=7
repo1-retention-archive-type=full
archive-async=y
# Never configure archive-push-queue-max or archive-queue-max. Any value is a
# WAL-drop threshold and can silently break the recovery chain.
spool-path=/var/spool/pgbackrest
process-max=2
start-fast=y
log-level-console=info
log-level-file=off

[home-agent]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=home_agent_backup
pg1-database=home_agent
