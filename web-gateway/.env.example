# Dedicated browser trust boundary. Required to enable browser Home Agent
# routes. Every value must be an exact HTTPS origin with no path, query,
# fragment, or credentials. The reverse proxy must preserve the original Host.
HOME_WEB_AGENT_ORIGINS=https://agent.home.example.internal

# Separate exact HTTPS origin used only by native Rust bearer/proof routes.
# It must equal HOME_AGENT_NATIVE_PUBLIC_ORIGIN in the BFF deployment and
# HOME_NATIVE_AGENT_BFF_URL on Windows. Native routes fail closed on every
# other Host, including the browser Agent and legacy UI origins.
HOME_WEB_NATIVE_AGENT_ORIGIN=https://native-agent.home.example.internal

# Loopback BFF target. Do not expose the BFF directly or bind it publicly.
HOME_WEB_AGENT_BFF_TARGET=http://127.0.0.1:8097/api/agent

# Legacy Home UI gateway authentication remains independent. It is never
# served on HOME_WEB_AGENT_ORIGINS.
HOME_WEB_AUTH_REQUIRED=1

# Quarantined legacy surface. A configured HA target alone never enables the
# generic browser WebSocket/service/camera/conversation proxy. Keep this off;
# use native Home Assistant for device control.
HOME_WEB_ENABLE_LEGACY_HA_PROXY=0
# HOME_WEB_HA_TARGET=http://homeassistant:8123
# With the legacy HA proxy on, a private (chmod 600) file holding the owner's
# long-lived HA token lets Home connect without asking for it.
# HOME_WEB_HA_TOKEN_FILE=/home/owner/.config/EngineeredLightingHome/ha-token

# Default home for light commands that name none (GET /api/home/location).
# Network: each home's LAN, matched against the device's direct Tailscale path.
# Phone: the owner's HA person entity (read with the HA token above) and the HA
# zone name that means each home. Leave unset to disable a signal.
# HOME_WEB_SITE_LANS=echo=192.168.0.0/24,victoria=192.168.1.0/24
# HOME_WEB_LOCATION_PERSON=person.owner
# HOME_WEB_SITE_ZONES=echo=home,victoria=Victoria

# The live den view: people markers from den-live (127.0.0.1:8111 on this host)
# in the den's apartment view. Off unless set.
# HOME_WEB_DEN_LIVE=1
# HOME_WEB_DEN_LIVE_TARGET=http://127.0.0.1:8111/api/den-live
# Look-only: any tailnet device without a session may read the den's live view,
# and nothing else. It needs the Serve listener below, with Tailscale Serve
# forwarding to it with --proxy-protocol=1 (see docs/TAILSCALE-WEB.md).
# HOME_WEB_LOOK_ONLY=1
# HOME_WEB_SERVE_PORT=5182

# Temporary production-camera compatibility. This does not expose the generic
# Vision API: the gateway pins the exact grounded-look methods and paths.
# Keep it off unless the authenticated legacy Home UI still needs camera looks.
HOME_WEB_ENABLE_LEGACY_VISION_PROXY=0
# HOME_WEB_VISION_TARGET=http://vision:8091

# Test-only escape; production ignores it unless NODE_ENV=test as well.
# HOME_WEB_ALLOW_INSECURE_TEST_AGENT_ORIGINS=1
