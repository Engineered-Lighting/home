{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-relation-hypothesis-1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "home-relation-hypothesis-1"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "domain_epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "person_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "room_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "domain_epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "track_epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
            },
            "pid": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
                }
              ]
            }
          },
          "required": [
            "site_id",
            "room_id",
            "session_id",
            "domain_epoch",
            "track_epoch",
            "pid"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "surface_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "interpretation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 128
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "contradicting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "uncertainty_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 128
    },
    "observed_at": {
      "type": "number",
      "minimum": 0
    },
    "available_at": {
      "type": "number",
      "minimum": 0
    },
    "valid_until": {
      "type": "number",
      "minimum": 0
    },
    "probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "calibration": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "person_ref",
    "surface_id",
    "interpretation",
    "alternatives",
    "supporting_evidence_refs",
    "contradicting_evidence_refs",
    "uncertainty_reasons",
    "observed_at",
    "available_at",
    "valid_until",
    "probability"
  ]
}
