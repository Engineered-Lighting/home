{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-live-intent-event-1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "home-live-intent-event-1"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "room_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "domain_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "manifest_ref": {
      "$ref": "#/$defs/pin"
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "origin": {
      "enum": [
        "human_declaration",
        "human_preference"
      ]
    },
    "truth_role": {
      "const": "runtime_intent"
    },
    "kind": {
      "enum": [
        "bind_profile",
        "unbind_profile"
      ]
    },
    "target": {
      "$ref": "#/$defs/person"
    },
    "set_at": {
      "type": "number",
      "minimum": 0
    },
    "available_at": {
      "type": "number",
      "minimum": 0
    },
    "valid_until": {
      "type": "number",
      "minimum": 0
    },
    "value": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile_ref": {
              "$ref": "#/$defs/pin"
            },
            "example_ref": {
              "$ref": "#/$defs/pin"
            }
          },
          "required": [
            "profile_ref",
            "example_ref"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reply_to": {
      "type": "null"
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "manifest_ref",
    "actor_ref",
    "origin",
    "truth_role",
    "kind",
    "target",
    "set_at",
    "available_at",
    "valid_until",
    "value",
    "reply_to"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unbind_profile"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile_ref": {
                "$ref": "#/$defs/pin"
              },
              "example_ref": {
                "$ref": "#/$defs/pin"
              }
            },
            "required": [
              "profile_ref",
              "example_ref"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "domain_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "track_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          ]
        }
      },
      "required": [
        "site_id",
        "room_id",
        "session_id",
        "domain_epoch",
        "track_epoch",
        "pid"
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ]
    }
  }
}
