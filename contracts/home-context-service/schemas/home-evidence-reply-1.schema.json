{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-evidence-reply-1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "home-evidence-reply-1"
    },
    "version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "domain_epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "terminal_status": {
      "enum": [
        "supported",
        "abstained",
        "unavailable",
        "denied",
        "expired",
        "cancelled"
      ]
    },
    "available_at": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema",
    "request_id",
    "correlation_id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "terminal_status",
    "available_at",
    "reason",
    "evidence_refs",
    "alternatives"
  ]
}
