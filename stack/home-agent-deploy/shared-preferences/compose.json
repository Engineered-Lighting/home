          }
        },
        {
          "type": "bind",
          "source": "${HOME_AGENT_ERASURE_LEDGER_ROOT:?set current authoritative ledger directory}",
          "target": "/erasure-ledger",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/dev/null",
          "target": "/erasure-ledger/ledger.jsonl",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": {
        "api": {
          "ipv4_address": "${HOME_AGENT_VICTORIA_PREFERENCES_IP:?set reserved private API-network address}"
        },
        "database": {}
      },
      "logging": {
        "driver": "local",
        "options": {
