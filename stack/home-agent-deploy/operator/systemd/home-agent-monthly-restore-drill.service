[Unit]
Description=Monthly isolated Home Agent PostgreSQL restore drill
Requires=docker.service srv-home\x2dagent.mount
After=docker.service srv-home\x2dagent.mount network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/srv/home-agent
ConditionPathExists=/srv/home-agent/config/home-agent.env
ConditionHost=!EngineeredLightingServer1
ConditionHost=!home-app

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME_AGENT_CHECKOUT=/opt/home/home-github
ExecStart=/usr/local/sbin/home-agent-monthly-restore-drill /srv/home-agent/config/home-agent.env
TimeoutStartSec=2h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=10
CPUAccounting=true
CPUQuota=100%
MemoryAccounting=true
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
TasksAccounting=true
TasksMax=256
LimitNOFILE=4096
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/home-agent/restore-drills
ReadWritePaths=/srv/home-agent/config
ReadWritePaths=/run/lock
ReadWritePaths=/var/run/docker.sock
