# ── Stack supervisor (control-plane API on :8093) ─────────────────────
# Used by the Home app's AI Stack Control card. Read by the
# `hav-stack-supervisor` systemd unit on the Ubuntu AI box (NOT the
# docker-compose project). The supervisor REFUSES TO START if either
# of these is missing/invalid — see services/supervisor/install.sh.

# Bearer token the Home app sends with every state-changing request.
# Generate one with:   openssl rand -hex 32
# Must be at least 16 characters. Rotate whenever a workstation that
# held it is lost/decommissioned (3 steps: update this file →
# `systemctl restart hav-stack-supervisor` → update the workstation's
# config.json under %APPDATA%\home-app\ or ~/.config/home-app/).
STACK_TOKEN=

# Interface the supervisor binds to. MUST be a Tailscale or LAN IP,
# NEVER 0.0.0.0 (the supervisor controls Docker, which is root-equivalent
# on this host). Examples:
#   BIND_ADDR=100.64.1.5     # Tailscale IP of this Ubuntu box
#   BIND_ADDR=192.168.0.100  # LAN IP of this Ubuntu box
BIND_ADDR=

# Model id the supervisor expects vLLM's /v1/models to report when "ready".
# Matches the --served-model-name flag in scripts/stack.sh.
# EXPECTED_VLLM_MODEL=qwen3-vl-30b

# ── Camera RTSP (full-res frames for /reason_zoom) ─────────────────────
# The vision sidecar's /reason_zoom grabs a full-resolution frame straight
# from each camera's RTSP main stream (Phase 0.5 — HA camera_proxy only
# serves Frigate's 720p detect sub-stream). Unset → /reason_zoom falls back
# to the 720p camera_proxy frame. CAMERA_RTSP_HOSTS maps a camera slug to
# its LAN IP, comma-separated.
CAMERA_RTSP_USER=
CAMERA_RTSP_PASS=
CAMERA_RTSP_HOSTS=kitchen=192.168.0.64,living_room=192.168.0.227,dining_room=192.168.0.92,workshop=192.168.0.54,driveway=192.168.0.68
# Optional — RTSP stream path (default stream1 = main/high-res) and port.
# CAMERA_RTSP_STREAM=stream1
# CAMERA_RTSP_PORT=554
