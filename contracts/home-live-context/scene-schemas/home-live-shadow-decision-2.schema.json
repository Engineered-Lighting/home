        "reason"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "const": "not_implemented"
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "pending": {
      "type": "array",
      "maxItems": 0
    },
    "intent_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settlement"
      },
      "maxItems": 128
    },
    "input_results": {
      "type": "array",
