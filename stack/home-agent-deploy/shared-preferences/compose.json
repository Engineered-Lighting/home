        "HOME_AGENT_ROLLOUT_MODE": "${HOME_AGENT_SHARED_ROLLOUT_MODE:?set reviewed shadow or canary mode}",
        "HOME_AGENT_READINESS_MIGRATION": "0047_personal_pref_authority_v1",
        "HOME_AGENT_STORAGE_MONITOR_PATH": "/storage-monitor/durable",
