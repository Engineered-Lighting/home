{
  "name": "home",
  "version": "0.1.0",
  "description": "Local AI home coordinator. The existing Home desktop app lives in app/; experimental sibling apps live under apps/.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "serve app/src -p 5180 --no-clipboard --no-port-switching",
    "dev:assets": "node tools/serve-apartment-assets.mjs",
    "dev:simulation": "serve app/src -p 5180 --no-clipboard --no-port-switching",
    "web:dev": "node web-gateway/server.mjs",
    "web:start": "node web-gateway/server.mjs",
    "web:check": "node web-gateway/server.mjs --check",
    "web:mobile-audit": "node tools/mobile-web-screenshot-audit.mjs",
    "web:mobile-audit:matrix": "node tools/mobile-web-screenshot-audit.mjs --matrix-only",
    "test:services": "node tools/run-home-services-tests.js",
    "dev:home2": "npm --workspace apps/home-2 run dev",
    "build:home2": "npm --workspace apps/home-2 run build",
    "test:home2": "npm --workspace apps/home-2 run test"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
