# /etc/tailscale-origin/victoria-agent.env (root:root 0644, no secrets)
# Victoria sign-in browser origin: Serve forwards raw TCP, and victoria-link
# terminates TLS itself with this node's exported Let's Encrypt certificate.
TS_ORIGIN_PORT=41652
TS_ORIGIN_CERT_DIR=/srv/home-agent/shared-preferences/prepared-20260928/victoria-bff/config/browser-tls
TS_ORIGIN_CERT_OWNER=1000:1000
TS_ORIGIN_RESTART_CONTAINER=home-shared-preferences-victoria-link-1
