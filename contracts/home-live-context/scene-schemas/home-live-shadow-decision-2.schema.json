    "version",
    "id",
    "site_id",
    "room_id",
    "session_id",
    "domain_epoch",
    "manifest_ref",
    "worker_id",
    "seq",
    "semantic_seq",
    "t",
    "input_cut",
    "engagement_ref",
    "scene",
    "goal",
    "allocation",
    "execution",
    "pending",
    "intent_results",
    "input_results",
    "display_lease",
