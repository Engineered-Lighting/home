        "person_ref": {
          "$ref": "#/$defs/person"
        },
        "subject_ref": {
          "$ref": "#/$defs/subject"
        },
        "profile_ref": {
          "$ref": "#/$defs/pin"
        },
        "example_ref": {
          "$ref": "#/$defs/pin"
