# Dedicated browser trust boundary. Required to enable browser Home Agent
# routes. Every value must be an exact HTTPS origin with no path, query,
# fragment, or credentials. The reverse proxy must preserve the original Host.
HOME_WEB_AGENT_ORIGINS=https://agent.home.example.internal

# Separate exact HTTPS origin used only by native Rust bearer/proof routes.
# It must equal HOME_AGENT_NATIVE_PUBLIC_ORIGIN in the BFF deployment and
# HOME_NATIVE_AGENT_BFF_URL on Windows. Native routes fail closed on every
# other Host, including the browser Agent and legacy UI origins.
HOME_WEB_NATIVE_AGENT_ORIGIN=https://native-agent.home.example.internal

# Loopback BFF target. Do not expose the BFF directly or bind it publicly.
HOME_WEB_AGENT_BFF_TARGET=http://127.0.0.1:8097/api/agent

# Legacy Home UI gateway authentication remains independent. It is never
# served on HOME_WEB_AGENT_ORIGINS.
HOME_WEB_AUTH_REQUIRED=1

# Quarantined legacy surface. A configured HA target alone never enables the
# generic browser WebSocket/service/camera/conversation proxy. Keep this off;
# use native Home Assistant for device control.
HOME_WEB_ENABLE_LEGACY_HA_PROXY=0
# HOME_WEB_HA_TARGET=http://homeassistant:8123

# Test-only escape; production ignores it unless NODE_ENV=test as well.
# HOME_WEB_ALLOW_INSECURE_TEST_AGENT_ORIGINS=1
