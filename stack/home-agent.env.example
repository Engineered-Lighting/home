# Non-secret deployment settings for stack/home-agent-compose.yml.
# Root-only master values are mode 0600 under HOME_AGENT_SECRETS_DIR/master.
# Preflight creates mode-0400, UID-owned copies under runtime/<service>.

HOME_AGENT_DEPLOYMENT_ROOT=/srv/home-agent
HOME_AGENT_DATA_ROOT=/srv/home-agent/durable
HOME_AGENT_RUNTIME_ROOT=/srv/home-agent/runtime
HOME_AGENT_SESSION_ROOT=/srv/home-agent/sessions
HOME_AGENT_ERASURE_LEDGER_ROOT=/srv/home-agent/erasure-ledger
HOME_AGENT_SECRETS_DIR=/srv/home-agent/secrets
# A root-owned mode-0600 `master/native_installations.json` below this encrypted
# directory is mandatory. An empty v1 registry keeps every native route
# contained while browser OAuth remains available.
HOME_AGENT_TLS_DIR=/srv/home-agent/tls
# Standalone Ubuntu is the canonical topology. This repository is encrypted
# but shares the host and volume with PostgreSQL, so it is local recovery only,
# not off-host durability. The active deployment intentionally has no remote
# repository credential or backup network.
HOME_AGENT_BACKUP_TOPOLOGY=local
HOME_AGENT_PGBACKREST_CONF=/srv/home-agent/config/pgbackrest-local.conf
HOME_AGENT_PGBACKREST_LOCAL_REPO_ROOT=/srv/home-agent/durable/pgbackrest-repository
HOME_AGENT_PGBACKREST_SPOOL_ROOT=/srv/home-agent/durable/pgbackrest-spool-local-v1
HOME_AGENT_PGBACKREST_LOCK_FILE=/srv/home-agent/locks/pgbackrest-repository.lock
HOME_AGENT_PGBACKREST_BACKUP_LOCK_FILE=/srv/home-agent/locks/pgbackrest-backup.lock
# Reserve 2 GiB plus three times current PGDATA before a startup full backup.
HOME_AGENT_BACKUP_MIN_FREE_KIB=2097152
# The config must keep pg1-user=home_agent_backup. Its separate database
# password is generated into a mode-0400 backup-gate secret by preflight. The
# local repository must live on the encrypted mapper. Only
# pgBackRest-capable containers receive repository access.

# Isolated restore drills stage only beneath this root. It must be a root-owned
# mode-0700 directory on the encrypted mapper and must not contain PostgreSQL.
HOME_AGENT_RESTORE_DRILL_ROOT=/srv/home-agent/restore-drills
# Phase 3 schema/role groundwork is branch-only; production remains pinned here
# until the record-only gate and an explicit deployment review both pass. The
# identity-finalizer secret/role foundation is also inert: its login is expired
# and there is no activation helper or callable finalization function.
HOME_AGENT_EXPECTED_DB_REVISION=0006a_worker_lease_arbitration
# This tag is resolved to an immutable image ID at drill start. The image must
# carry a base-image label exactly matching the digest-pinned image below.
HOME_AGENT_PGBACKREST_IMAGE=engineered-lighting/home-agent-postgres:17.10
# Resolve this installed image tag once during deployment; scheduled backups
# invoke the immutable local image ID directly.
HOME_AGENT_PGBACKREST_IMAGE_ID=sha256:REPLACE_WITH_LOCAL_IMAGE_ID
HOME_AGENT_LOCAL_BACKUP_MANIFEST=/srv/home-agent/config/local-backup-operator.sha256
# Optional operational bounds:
# HOME_AGENT_RESTORE_SFTP_TIMEOUT_SECONDS=7200
# HOME_AGENT_RESTORE_PHASE_TIMEOUT_SECONDS=3600
# HOME_AGENT_RESTORE_MIN_FREE_KIB=2097152
# HOME_AGENT_RESTORE_KEEP_FAILED=0

# Exact host address reachable from Home Assistant and restricted by the host
# firewall to the HA host. Never use 0.0.0.0.
HOME_AGENT_EDGE_BIND_ADDR=192.168.0.100
HOME_AGENT_BFF_BIND_ADDR=127.0.0.1
HOME_AGENT_BFF_PORT=8097

# Stable, single-container OAuth egress boundary. The matching host firewall
# rule admits only this source/interface to this host's local Tailscale HA
# listener; it does not admit LAN, Internet, or other Docker sources inbound.
HOME_AGENT_BFF_EGRESS_SUBNET=172.22.0.0/24
HOME_AGENT_BFF_EGRESS_GATEWAY=172.22.0.1
HOME_AGENT_BFF_EGRESS_IP=172.22.0.10
HOME_AGENT_BFF_EGRESS_BRIDGE=ha-bff-egress0

# Pinned internal semantic API network. Dynamic services allocate only from
# the upper half; reviewed fixed service addresses must remain outside it.
HOME_AGENT_API_SUBNET=172.23.0.0/16
HOME_AGENT_API_DYNAMIC_RANGE=172.23.128.0/17
HOME_AGENT_API_GATEWAY=172.23.0.1

HOME_AGENT_ALLOWED_ORIGINS=https://home-app.example.ts.net:8443
HOME_AGENT_HA_URL=https://homeassistant.example.internal
# Required static self-address for the pre-Docker UFW lifecycle guard. Set it
# to the single IPv4 printed by `tailscale ip -4`; the live verifier also proves
# that HOME_AGENT_HA_URL resolves to this exact online node address.
HOME_AGENT_HA_TAILSCALE_IPV4=
HOME_AGENT_OAUTH_CLIENT_ID=https://home-app.example.ts.net:8443
HOME_AGENT_OAUTH_REDIRECT_URI=https://home-app.example.ts.net:8443/api/agent/auth/callback
# Must exactly equal the dedicated web-gateway origin configured as
# HOME_WEB_NATIVE_AGENT_ORIGIN and the Windows HOME_NATIVE_AGENT_BFF_URL. It is
# a separate audience from both browser origins above and must not appear
# anywhere in HOME_AGENT_ALLOWED_ORIGINS.
HOME_AGENT_NATIVE_PUBLIC_ORIGIN=https://native-agent.home.example.internal
HOME_AGENT_POST_LOGIN_REDIRECT=/home-agent/index.html

# sha256sum stack/home-agent-deploy/policy/home-agent-mvp-v1.json
HOME_AGENT_POLICY_DIGEST=
HOME_AGENT_ROLLOUT_MODE=record_only

# Immutable official multi-platform PostgreSQL 17.10 Bookworm index.
HOME_AGENT_POSTGRES_IMAGE=postgres:17.10-bookworm@sha256:17b6c778de50f4bb9a878c36e736110fbcd9b7020377d6fdfdf20f7c0347e40a
HOME_AGENT_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine
