# Non-secret deployment settings for stack/home-agent-compose.yml.
# Root-only master values are mode 0600 under HOME_AGENT_SECRETS_DIR/master.
# Preflight creates mode-0400, UID-owned copies under runtime/<service>.

HOME_AGENT_DATA_ROOT=/srv/home-agent/durable
HOME_AGENT_RUNTIME_ROOT=/srv/home-agent/runtime
HOME_AGENT_SESSION_ROOT=/srv/home-agent/sessions
HOME_AGENT_ERASURE_LEDGER_ROOT=/srv/home-agent/erasure-ledger
HOME_AGENT_SECRETS_DIR=/etc/home-agent/secrets
HOME_AGENT_TLS_DIR=/etc/home-agent/tls
HOME_AGENT_PGBACKREST_CONF=/etc/home-agent/pgbackrest.conf
HOME_AGENT_PGBACKREST_SFTP_KEY=/etc/home-agent/backup-sftp/id_ed25519
HOME_AGENT_PGBACKREST_SFTP_PUBLIC_KEY=/etc/home-agent/backup-sftp/id_ed25519.pub
# The config must keep pg1-user=home_agent_backup. Its separate database
# password is generated into a mode-0400 backup-gate secret by preflight. The
# SFTP key files must live on the encrypted mapper and are mounted read-only.

# Exact host address reachable from Home Assistant and restricted by the host
# firewall to the HA host. Never use 0.0.0.0.
HOME_AGENT_EDGE_BIND_ADDR=192.168.0.100
HOME_AGENT_BFF_BIND_ADDR=127.0.0.1
HOME_AGENT_BFF_PORT=8097

HOME_AGENT_ALLOWED_ORIGINS=https://agent.home.example.internal
HOME_AGENT_HA_URL=https://homeassistant.example.internal
HOME_AGENT_OAUTH_CLIENT_ID=https://agent.home.example.internal
HOME_AGENT_OAUTH_REDIRECT_URI=https://agent.home.example.internal/api/agent/auth/callback
HOME_AGENT_POST_LOGIN_REDIRECT=/home-agent/index.html

# sha256sum stack/home-agent-deploy/policy/home-agent-mvp-v1.json
HOME_AGENT_POLICY_DIGEST=
HOME_AGENT_ROLLOUT_MODE=record_only

# Immutable official multi-platform PostgreSQL 17.10 Bookworm index.
HOME_AGENT_POSTGRES_IMAGE=postgres:17.10-bookworm@sha256:17b6c778de50f4bb9a878c36e736110fbcd9b7020377d6fdfdf20f7c0347e40a
HOME_AGENT_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine
