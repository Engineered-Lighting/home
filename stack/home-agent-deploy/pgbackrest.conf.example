# Standalone Ubuntu recovery configuration. Copy outside the repository, fill
# in a separately escrowed cipher passphrase, set mode 0640/root:GID-999 (the
# container postgres group), and point HOME_AGENT_PGBACKREST_CONF at it.
#
# /repository is an encrypted same-host recovery anchor. It protects against
# database mistakes and corruption, but not loss of the Ubuntu disk or host.
[global]
repo1-type=posix
repo1-path=/repository
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATE_BACKUP_SECRET
repo1-bundle=y
repo1-retention-full=4
repo1-retention-diff=7
repo1-retention-archive-type=full
archive-async=y
# Deliberately leave archive-push-queue-max unset. Every configured value,
# including 0B, is a drop threshold that can break the WAL archive stream.
spool-path=/var/spool/pgbackrest
process-max=1
start-fast=n
log-level-console=info
log-level-file=off

[home-agent]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=home_agent_backup
pg1-database=home_agent
