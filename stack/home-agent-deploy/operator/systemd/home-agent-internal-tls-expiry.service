[Unit]
Description=Warn before a shared-preference internal TLS leaf or its CA expires
RequiresMountsFor=/srv/home-agent
OnFailure=ntfy-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -s /usr/local/libexec/home-agent/shared-preferences/renew_internal_tls.py check-expiry --root /srv/home-agent/shared-preferences/prepared-20260928
# '+' runs only the streak reset outside the sandbox: it must clear
# /run/ntfy-alert and may send a RECOVERED notice. The check stays confined.
ExecStartPost=+/usr/local/sbin/ntfy-alert-reset %n
TimeoutStartSec=2min
UMask=0077
CPUQuota=10%
MemoryMax=128M
TasksMax=16
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
